<script>
// LOGIN BLOCK: Validates the simple demo login and displays the dashboard.
function login() {
  const user = document.getElementById("username").value.trim();
  const pass = document.getElementById("password").value.trim();
  const errorBox = document.getElementById("loginError");

  // Check the original demo credentials
  if (user === "admin" && pass === "1234") {
    document.getElementById("loginPage").style.display = "none";
    document.getElementById("dashboard").style.display = "block";
    errorBox.style.display = "none";
    return;
  }

  // Check accounts created via signup (stored in localStorage)
  const accounts = JSON.parse(localStorage.getItem("smartbuilding_accounts") || "[]");
  const matched = accounts.find(a => a.username === user && a.password === pass && a.verified);

  if (matched) {
    document.getElementById("loginPage").style.display = "none";
    document.getElementById("dashboard").style.display = "block";
    errorBox.style.display = "none";
  } else {
    // Helpful diagnostic if account exists but isn't verified
    const unverified = accounts.find(a => a.username === user && a.password === pass && !a.verified);
    if (unverified) {
      errorBox.textContent = "Account not verified. Please check your email for the code.";
    } else {
      errorBox.textContent = "Wrong username or password. Please try again.";
    }
    errorBox.style.display = "block";
  }
}

// LOGOUT BLOCK: Hides the dashboard and returns to the login page.
function logout() {
  document.getElementById("dashboard").style.display = "none";
  document.getElementById("loginPage").style.display = "flex";
  document.getElementById("username").value = "";
  document.getElementById("password").value = "";
}

document.addEventListener("keydown", function(event) {
  if (event.key === "Enter" && document.getElementById("loginPage").style.display !== "none") {
    login();
  }
});

/* ═══════════════════════════════════════════════════════════════
   ADDED: Multi-screen authentication flow
   ═══════════════════════════════════════════════════════════════ */

// ─── Screen navigation ─────────────────────────────────────────
function showScreen(screenId) {
  ["loginPage", "signupScreen", "verifyScreen", "forgotScreen"].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = "none";
  });
  const target = document.getElementById(screenId);
  if (target) target.style.display = "flex";

  // Hide error/success on screen change
  ["signupError", "verifyError", "verifySuccess", "forgotError", "forgotSuccess"].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = "none";
  });
}

// ─── Account storage helpers ───────────────────────────────────
function getAccounts() {
  return JSON.parse(localStorage.getItem("smartbuilding_accounts") || "[]");
}
function saveAccounts(arr) {
  localStorage.setItem("smartbuilding_accounts", JSON.stringify(arr));
}

// ─── SIGN UP ───────────────────────────────────────────────────
function signup() {
  const username = document.getElementById("signupUsername").value.trim();
  const email    = document.getElementById("signupEmail").value.trim();
  const pwd      = document.getElementById("signupPassword").value;
  const confirm  = document.getElementById("signupConfirm").value;
  const errorBox = document.getElementById("signupError");

  if (!username || !email || !pwd || !confirm) {
    errorBox.textContent = "Please fill in all fields.";
    errorBox.style.display = "block";
    return;
  }
  if (!/^[A-Za-z0-9_.-]{3,64}$/.test(username)) {
    errorBox.textContent = "Username must be 3–64 characters (letters, digits, _ . -).";
    errorBox.style.display = "block";
    return;
  }
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    errorBox.textContent = "Please enter a valid email address.";
    errorBox.style.display = "block";
    return;
  }
  if (pwd.length < 6) {
    errorBox.textContent = "Password must be at least 6 characters.";
    errorBox.style.display = "block";
    return;
  }
  if (pwd !== confirm) {
    errorBox.textContent = "Passwords do not match.";
    errorBox.style.display = "block";
    return;
  }

  const accounts = getAccounts();
  if (accounts.find(a => a.username === username)) {
    errorBox.textContent = "Username is already taken.";
    errorBox.style.display = "block";
    return;
  }
  if (accounts.find(a => a.email === email)) {
    errorBox.textContent = "An account with that email already exists.";
    errorBox.style.display = "block";
    return;
  }

  // Generate a 6-digit verification code
  const code = String(Math.floor(100000 + Math.random() * 900000));
  accounts.push({
    username: username,
    email: email,
    password: pwd,
    verified: false,
    verifyCode: code,
    createdAt: new Date().toISOString()
  });
  saveAccounts(accounts);

  // Move to verify screen
  document.getElementById("verifyEmailDisplay").textContent = email;
  document.getElementById("verifyDemoCode").textContent = code;
  // Reset digit inputs
  document.querySelectorAll(".verify-digit").forEach(inp => inp.value = "");
  showScreen("verifyScreen");
}

// ─── VERIFY ACCOUNT ────────────────────────────────────────────
function moveToNext(input, index) {
  // Only allow digits
  input.value = input.value.replace(/[^0-9]/g, "");
  if (input.value && index < 5) {
    const next = document.querySelectorAll(".verify-digit")[index + 1];
    if (next) next.focus();
  }
}

function verifyAccount() {
  const digits = Array.from(document.querySelectorAll(".verify-digit"))
    .map(i => i.value).join("");
  const errorBox = document.getElementById("verifyError");
  const successBox = document.getElementById("verifySuccess");
  errorBox.style.display = "none";
  successBox.style.display = "none";

  if (digits.length !== 6) {
    errorBox.textContent = "Please enter all 6 digits.";
    errorBox.style.display = "block";
    return;
  }

  const accounts = getAccounts();
  // Find the most recent unverified account that matches the code
  const match = [...accounts].reverse().find(a => !a.verified && a.verifyCode === digits);
  if (!match) {
    errorBox.textContent = "The code is incorrect. Please try again.";
    errorBox.style.display = "block";
    return;
  }

  match.verified = true;
  saveAccounts(accounts);
  successBox.textContent = "Account verified successfully. Redirecting to login…";
  successBox.style.display = "block";
  setTimeout(() => {
    document.getElementById("username").value = match.username;
    document.getElementById("password").value = "";
    showScreen("loginPage");
  }, 1500);
}

function resendCode() {
  const accounts = getAccounts();
  const unverified = [...accounts].reverse().find(a => !a.verified);
  if (!unverified) {
    alert("No pending verification found.");
    return;
  }
  const newCode = String(Math.floor(100000 + Math.random() * 900000));
  unverified.verifyCode = newCode;
  saveAccounts(accounts);
  document.getElementById("verifyDemoCode").textContent = newCode;
  alert("A new code has been generated (demo mode shows it on screen).");
}

// ─── FORGOT PASSWORD ───────────────────────────────────────────
function sendResetLink() {
  const email = document.getElementById("forgotEmail").value.trim();
  const errorBox   = document.getElementById("forgotError");
  const successBox = document.getElementById("forgotSuccess");
  errorBox.style.display = "none";
  successBox.style.display = "none";

  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    errorBox.textContent = "Please enter a valid email address.";
    errorBox.style.display = "block";
    return;
  }

  const accounts = getAccounts();
  const account = accounts.find(a => a.email === email);
  if (!account) {
    errorBox.textContent = "No account found with that email.";
    errorBox.style.display = "block";
    return;
  }

  // In a real system this would send an email with a reset link.
  // In demo mode, we simulate the email and show the temporary password.
  const tempPassword = "reset" + Math.floor(1000 + Math.random() * 9000);
  account.password = tempPassword;
  saveAccounts(accounts);

  successBox.innerHTML =
    "A reset link has been sent to <strong>" + email + "</strong>.<br>" +
    "<em>Demo mode:</em> your temporary password is <strong>" + tempPassword + "</strong>";
  successBox.style.display = "block";
}
</script>

