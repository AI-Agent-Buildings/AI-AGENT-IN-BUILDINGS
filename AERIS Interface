function getTargetValue(meanValue, lowerValue, upperValue, fallbackValue) {
  if (meanValue !== undefined && Number.isFinite(Number(meanValue))) return Number(meanValue);
  if (lowerValue !== undefined && upperValue !== undefined) return (Number(lowerValue) + Number(upperValue)) / 2;
  return fallbackValue;
}

function buildLocalRecommendation(data, tStatus, hStatus) {
  const targetTemp = getTargetValue(data.temp_mean ?? data.recommended_temperature, data.temp_lower, data.temp_upper, 22);
  const targetHum = getTargetValue(data.hum_mean ?? data.recommended_humidity, data.hum_lower, data.hum_upper, 55);
  const tips = [];

  if (tStatus.includes("High")) {
    tips.push(`Decrease temperature toward ${targetTemp.toFixed(1)}°C to maintain a comfortable indoor environment.`);
  } else if (tStatus.includes("Low")) {
    tips.push(`Increase temperature toward ${targetTemp.toFixed(1)}°C to maintain a comfortable indoor environment.`);
  }

  if (hStatus.includes("High")) {
    tips.push(`Decrease humidity toward ${targetHum.toFixed(1)}% using ventilation or dehumidification.`);
  } else if (hStatus.includes("Low")) {
    tips.push(`Increase humidity toward ${targetHum.toFixed(1)}% to maintain indoor comfort.`);
  }

  if (tips.length === 0) {
    return `Conditions are normal. Maintain temperature near ${targetTemp.toFixed(1)}°C and humidity near ${targetHum.toFixed(1)}%.`;
  }

  return tips.join(" ");
}

