      scales: {
        x: { type: "category", ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 8, color: FAINT, font: { family: "'JetBrains Mono', monospace", size: 10 }, callback(val) { const d = new Date(this.getLabelForValue(val)); return d.toLocaleDateString("en-GB", { month: "short", day: "2-digit" }); } }, grid: { color: "rgba(24,24,27,0.06)", drawBorder: false, tickColor: "rgba(0,0,0,0)" } },
        y: { ticks: { color: FAINT, font: { family: "'JetBrains Mono', monospace", size: 10 }, callback: v => target === "temperature" ? `${v.toFixed(1)}°` : `${v.toFixed(0)}%` }, grid: { color: "rgba(24,24,27,0.06)", drawBorder: false, tickColor: "rgba(0,0,0,0)" } }
      }
    }
  });
}

function renderAvpModel(containerId, modelKey, label) {
  const container = document.getElementById(containerId);
  if (!container) return;
  const data = AVP_DATA[modelKey];
  for (const room of [1, 2, 3]) {
    const d = data[String(room)];
    const block = document.createElement("div");
    block.className = "room-block";
    const tId = `avp-${modelKey}-t-${room}`;
    const hId = `avp-${modelKey}-h-${room}`;
    block.innerHTML = `
      <div class="room-head">
        <div class="num">0${room}</div>
        <div class="title">${AVP_ROOM_NAMES[room]}</div>
        <div class="n-samples">${d.aT.length} readings · Jan – Jun 2024</div>
      </div>
      <div class="chart-row">
        <div class="chart-head">
          <div class="chart-title">Temperature <em>(°C)</em></div>
          <div class="scores"><span class="badge">${label} MAE<strong>${d.maeT.toFixed(2)} °C</strong></span></div>
        </div>
        <div class="chart-frame"><!-- CANVAS: Chart.js draws graphs inside this canvas. -->
<canvas id="${tId}"></canvas></div>
        <div class="chart-explanation">
          <p><strong>What this shows:</strong> The black line is the actual recorded temperature in Room ${room}. The coloured line is what the ${label} model predicted for the same timestamps.</p>
          <p><strong>Prediction accuracy:</strong> MAE = <strong>${d.maeT.toFixed(2)} °C</strong>. ${d.maeT < 0.5 ? "Excellent fit (below ±0.5 °C comfort threshold) — suitable for proactive HVAC control." : d.maeT < 1.0 ? "Reasonable fit for smart-building scheduling with supplementary sensor feedback." : "Noticeable deviation — reactive rather than predictive HVAC control is recommended."}</p>
          <p><strong>Energy efficiency:</strong> ${d.maeT < 0.6 ? "Predictions this accurate support pre-conditioning rooms before occupancy, cutting peak cooling loads and reducing compressor cycling." : "Model predictions should be combined with real-time sensor readings for optimal HVAC efficiency in this room."}</p>
        </div>
      </div>
      <div class="chart-row">
        <div class="chart-head">
          <div class="chart-title">Humidity <em>(%)</em></div>
          <div class="scores"><span class="badge">${label} MAE<strong>${d.maeH.toFixed(2)} %</strong></span></div>
        </div>
        <div class="chart-frame"><canvas id="${hId}"></canvas></div>
        <div class="chart-explanation">
          <p><strong>What this shows:</strong> Actual vs predicted relative humidity (%) for Room ${room} over the Jan–Jun 2024 test period.</p>
          <p><strong>Prediction accuracy:</strong> MAE = <strong>${d.maeH.toFixed(2)}%</strong>. ${d.maeH < 5 ? "Strong humidity tracking — dehumidification can be scheduled proactively from model output alone." : d.maeH < 7.5 ? "Moderate accuracy; useful for trend-based ventilation scheduling alongside real-time sensors." : "Humidity is inherently harder to predict than temperature. Higher error reflects variability from occupancy and ventilation events."}</p>
          <p><strong>Energy efficiency:</strong> Accurate humidity forecasting reduces over-cooling used as a dehumidification proxy — a key source of wasted energy in Gulf-region buildings where outdoor humidity regularly exceeds 80% RH.</p>
        </div>
      </div>
    `;
    container.appendChild(block);
    buildAvpChart(tId, d.ts, d.aT, d.pT, "temperature", modelKey, d.maeT);
    buildAvpChart(hId, d.ts, d.aH, d.pH, "humidity",    modelKey, d.maeH);
  }
}

function renderModelSummary() {
  const container = document.getElementById("model-summary-section");
  if (!container) return;
  const models = [
    { key: "ridge",   label: "Ridge Regression", color: "#2563eb", desc: "Fourier-feature linear model" },
    { key: "lstm",    label: "LSTM",              color: "#d97706", desc: "Recurrent neural network (seq_len=7)" },
    { key: "agentic", label: "Agentic AI",        color: "#16a34a", desc: "Statistical-context LLM reasoning" }
  ];
  let rows = "";
  for (const m of models) {
    const d = AVP_DATA[m.key];
    const avgMaeT = (([1,2,3].map(r => d[r].maeT).reduce((a,b)=>a+b,0))/3).toFixed(3);
    const avgMaeH = (([1,2,3].map(r => d[r].maeH).reduce((a,b)=>a+b,0))/3).toFixed(3);
    rows += `<tr><td><span class="summary-dot" style="background:${m.color}"></span><strong>${m.label}</strong><br><small>${m.desc}</small></td><td class="num-cell">${d["1"].maeT.toFixed(3)}</td><td class="num-cell">${d["2"].maeT.toFixed(3)}</td><td class="num-cell">${d["3"].maeT.toFixed(3)}</td><td class="num-cell avg-cell">${avgMaeT}</td><td class="num-cell">${d["1"].maeH.toFixed(3)}</td><td class="num-cell">${d["2"].maeH.toFixed(3)}</td><td class="num-cell">${d["3"].maeH.toFixed(3)}</td><td class="num-cell avg-cell">${avgMaeH}</td></tr>`;
  }
  container.innerHTML = `
    <div class="summary-prose">
      <p>The table below presents the Mean Absolute Error (MAE) for each model across all three rooms, evaluated against the <strong>Jan–Jun 2024 test dataset (1,058 sensor readings)</strong>. MAE is reported in °C for temperature and % for humidity — lower values indicate better accuracy.</p>
      <p>All three models demonstrate viable performance for smart-building energy management. <strong>Ridge Regression</strong> and <strong>Agentic AI</strong> achieve the lowest temperature MAE (~0.41–0.57 °C), well within the ±0.5 °C comfort-control threshold. The <strong>LSTM</strong> shows slightly higher temperature error in Room 1 (Kitchen, 1.004 °C) but captures short-term temporal dependencies. Humidity prediction is consistently harder across all models (MAE 5.8–9.0%), driven by occupancy and ventilation variability that timestamp-only features cannot encode.</p>
      <p>For deployment, Ridge Regression offers the best balance of accuracy, interpretability, and computational simplicity. LSTM is preferred when recent sensor history is available and short-term anomaly detection is needed. Agentic AI provides a maintainable, re-configurable alternative that matches Ridge accuracy without requiring model re-training.</p>
    </div>
    <div class="summary-table-wrap">
      <table class="summary-table">
        <thead>
          <tr><th rowspan="2">Model</th><th colspan="4">Temperature MAE (°C) ↓</th><th colspan="4">Humidity MAE (%) ↓</th></tr>
          <tr><th>Room 1</th><th>Room 2</th><th>Room 3</th><th class="avg-cell">Average</th><th>Room 1</th><th>Room 2</th><th>Room 3</th><th class="avg-cell">Average</th></tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>
    </div>
  `;
}

function runCharts() {
  if (typeof Chart === "undefined") { console.warn("Chart.js not loaded"); return; }
  renderAvpModel("avp-ridge",   "ridge",   "Ridge",   "--accent");
  renderAvpModel("avp-lstm",    "lstm",    "LSTM",    "--warning");
  renderAvpModel("avp-agentic", "agentic", "Agentic", "--success");
  renderModelSummary();
}
if (typeof Chart !== "undefined") runCharts();
else window.addEventListener("load", runCharts);

</script>

