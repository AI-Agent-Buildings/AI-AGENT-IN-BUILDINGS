</script>
<style>
/*
===============================================================================
CSS STYLING SECTION
-------------------------------------------------------------------------------
This block controls the visual appearance of the dashboard:
- colors
- cards
- buttons
- login screen
- layout
- charts
- responsive design
===============================================================================
*/

  /* Global design variables such as colors, shadows, and border radius. */
:root {
    --bg: #fafafa; --surface: #ffffff; --surface-2: #f4f4f5;
    --rule: #e4e4e7; --rule-strong: #d4d4d8;
    --ink: #18181b; --ink-soft: #3f3f46; --ink-faint: #71717a;
    --accent: #2563eb; --accent-soft: #dbeafe;
    --warning: #d97706; --warning-soft: #fef3c7;
    --success: #16a34a; --success-soft: #dcfce7;
    --danger: #dc2626; --danger-soft: #fee2e2;
    --rust: #2563eb;  /* used by chart JS */
    --sage: #16a34a;
    --grid: rgba(24,24,27,0.06);
  }
  /* Reset spacing so elements behave consistently across browsers. */
* { box-sizing: border-box; margin: 0; padding: 0; }
  html, /* Main page background and default font setup. */
body {
    background: var(--bg); color: var(--ink);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 15px; line-height: 1.5;
    -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
  }
  .page { max-width: 1120px; margin: 0 auto; padding: 40px 32px 64px; }

  /* Header */
  .masthead { padding-bottom: 24px; border-bottom: 1px solid var(--rule); margin-bottom: 32px; }
  .masthead-top {
    font-family: 'JetBrains Mono', monospace; font-size: 11px;
    color: var(--ink-faint); margin-bottom: 20px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .status-pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 3px 9px; border-radius: 999px;
    font-size: 10px; font-weight: 500; letter-spacing: 0.02em;
    font-family: 'Inter', sans-serif;
    background: var(--surface-2); color: var(--ink-faint);
    border: 1px solid var(--rule);
    transition: all 0.2s;
  }
  .status-pill .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--ink-faint);
  }
  .status-pill.ok    { background: var(--success-soft); color: var(--success); border-color: var(--success); }
  .status-pill.ok    .dot { background: var(--success); }
  .status-pill.warn  { background: var(--warning-soft); color: var(--warning); border-color: var(--warning); }
  .status-pill.warn  .dot { background: var(--warning); }
  .status-pill.err   { background: var(--danger-soft); color: var(--danger); border-color: var(--danger); }
  .status-pill.err   .dot { background: var(--danger); }

  h1 { font-size: clamp(28px, 3.4vw, 36px); font-weight: 600; letter-spacing: -0.02em; }
  .tagline { font-size: 14px; color: var(--ink-faint); margin-top: 6px; }
  .subhead {
    display: flex; gap: 24px; flex-wrap: wrap;
    font-family: 'JetBrains Mono', monospace; font-size: 11px;
    color: var(--ink-faint); margin-top: 16px;
  }
  .subhead span::before {
    content: ""; display: inline-block; width: 4px; height: 4px;
    background: var(--rule-strong); border-radius: 50%;
    margin-right: 10px; vertical-align: middle;
  }

  /* Layout */
  .main { display: grid; grid-template-columns: 380px 1fr; gap: 24px; margin-top: 32px; }
  /* Responsive rules for smaller screens. */
@media (max-width: 860px) {
    .main { grid-template-columns: 1fr; }
    .page { padding: 28px 20px 48px; }
  }
  .panel {
    background: var(--surface); border: 1px solid var(--rule);
    border-radius: 8px; padding: 24px;
  }
  .panel-label {
    font-family: 'JetBrains Mono', monospace; font-size: 10px;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-faint); margin-bottom: 4px;
    display: flex; justify-content: space-between;
  }
  .panel-title {
    font-size: 17px; font-weight: 600; margin-bottom: 20px; letter-spacing: -0.01em;
  }

  /* Fields */
  .field { margin-bottom: 16px; }
  .field-label {
    display: flex; justify-content: space-between; align-items: baseline;
    font-size: 13px; font-weight: 500; color: var(--ink-soft); margin-bottom: 6px;
  }
  .field-label .hint { font-weight: 400; font-size: 12px; color: var(--ink-faint); }
  .field input[type="date"], .field input[type="time"] {
    width: 100%; background: var(--surface);
    border: 1px solid var(--rule-strong); border-radius: 6px;
    padding: 9px 12px;
    font-family: 'Inter', sans-serif; font-size: 14px; color: var(--ink);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .field input:focus {
    outline: none; border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .field-row { display: grid; grid-template-columns: 1.4fr 1fr; gap: 8px; }

  .segmented {
    display: grid; grid-template-columns: repeat(3, 1fr);
    background: var(--surface-2); border: 1px solid var(--rule);
    border-radius: 6px; padding: 3px; gap: 3px;
  }
  .segmented label {
    padding: 9px 0; text-align: center; font-size: 14px; font-weight: 500;
    color: var(--ink-soft); cursor: pointer; border-radius: 4px;
    transition: background-color 0.15s, color 0.15s, box-shadow 0.15s;
    position: relative;
    user-select: none; -webkit-user-select: none;
  }
  .segmented label:hover { color: var(--ink); }
  /* Hide the input visually but keep it interactive for label forwarding.
     IMPORTANT: do NOT set pointer-events:none — breaks label clicks on Safari. */
  .segmented input {
    position: absolute; inset: 0;
    opacity: 0; margin: 0; cursor: pointer;
  }
  /* Let the span sit on top visually but pass clicks through to the label. */
  .segmented label > span {
    position: relative; z-index: 1; pointer-events: none;
    display: block;
  }
  /* Apply the checked pill to the LABEL, not to a margin-warped span. */
  .segmented label:has(input:checked) {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0,0,0,0.08), 0 0 0 1px var(--rule);
  }
  /* Flash animation when prediction renders — confirms the UI updated. */
  @keyframes pulse-flash {
    0%   { box-shadow: 0 0 0 0 rgba(37,99,235,0.35); }
    100% { box-shadow: 0 0 0 8px rgba(37,99,235,0); }
  }

  /* Webhook URL input */
  .webhook-config {
    margin-top: 18px; padding: 14px; background: var(--surface-2);
    border: 1px solid var(--rule); border-radius: 6px;
  }
  .webhook-config-label {
    font-family: 'JetBrains Mono', monospace; font-size: 10px;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-faint); margin-bottom: 8px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .webhook-config input {
    width: 100%; background: var(--surface);
    border: 1px solid var(--rule-strong); border-radius: 4px;
    padding: 7px 10px;
    font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--ink);
  }
  .webhook-config input:focus {
    outline: none; border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .webhook-config .hint {
    margin-top: 8px; font-size: 11px; color: var(--ink-faint); line-height: 1.5;
  }
  .webhook-config .hint strong { color: var(--ink-soft); font-weight: 600; }

  /* Backend picker — three options: regression / llm / local */
  .backend-picker {
    display: grid; grid-template-columns: repeat(3, 1fr);
    background: var(--surface); border: 1px solid var(--rule);
    border-radius: 6px; padding: 3px; gap: 3px;
  }
  .backend-picker label {
    display: flex; flex-direction: column; align-items: center;
    padding: 10px 4px; cursor: pointer;
    border-radius: 4px; position: relative;
    transition: background-color 0.15s, box-shadow 0.15s;
    user-select: none; -webkit-user-select: none;
  }
  .backend-picker input {
    position: absolute; inset: 0;
    opacity: 0; margin: 0; cursor: pointer;
  }
  .backend-picker .backend-title {
    font-size: 12px; font-weight: 600; color: var(--ink-soft);
    pointer-events: none;
  }
  .backend-picker .backend-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px; color: var(--ink-faint); margin-top: 2px;
    pointer-events: none;
  }
  .backend-picker label:hover .backend-title { color: var(--ink); }
  .backend-picker label:has(input:checked) {
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--accent), 0 1px 2px rgba(37,99,235,0.08);
  }
  .backend-picker label:has(input:checked) .backend-title { color: var(--accent); }

  /* Submit */
  .submit-btn {
