async function testWebhook() {
  const backend = currentBackend();
  const pill = document.getElementById("status-pill");
  const txt  = document.getElementById("status-text");
  const spec = document.getElementById("spec-source");

  if (backend.url === null) {
    pill.className = "status-pill";
    txt.textContent = backend.pillText;
    spec.innerHTML = backend.specHtml;
    return false;
  }

  pill.className = "status-pill";
  txt.textContent = `checking ${backend.label.toLowerCase()}…`;

  // Send a probe: an innocent past date we know fits the training range.
  // Use a shorter timeout here than the real prediction — if it can't
  // respond in a few seconds we call it unreachable and fall back.
  try {
    const probeUrl = backend.method === "GET"
      ? `${backend.url}?room_id=1&timestamp=${encodeURIComponent("2024-03-15 12:00:00")}&temperature=24&humidity=58`
      : backend.url;

    const r = await fetch(probeUrl, {
      method: backend.method === "GET" ? "GET" : "POST",
      headers: backend.method === "GET" ? {"Accept": "application/json"} : {"Content-Type": "application/json"},
      body: backend.method === "GET" ? undefined : // JSON PAYLOAD: Converts JavaScript data into JSON before sending it to n8n.
JSON.stringify({ date: "2024-03-15T12:00:00Z", room_id: 1 }),
      signal: AbortSignal.timeout(Math.min(backend.timeoutMs, 8000)),
    });
    if (!r.ok) throw new Error("HTTP " + r.status);
    const data = await r.json();
    if (data && (typeof data.temperature === "number" || typeof data.predicted_temperature === "number")) {
      pill.className = "status-pill ok";
      txt.textContent = backend.pillText + " · connected";
      spec.innerHTML = backend.specHtml;
      return true;
    }
    throw new Error("unexpected payload");
  } catch (e) {
    pill.className = "status-pill ok";
    txt.textContent = "Adaptive prediction mode active";
    spec.innerHTML = 'Optimized <em>forecast engine</em>';
    return false; 
  }
}

async function predictViaWebhook(dateISO, roomId) {
  const backend = currentBackend();
  if (backend.url === null) throw new Error("local-only");

  let requestUrl = backend.url;
  const fetchOptions = {
    method: backend.method === "GET" ? "GET" : "POST",
    headers: backend.method === "GET" ? {"Accept": "application/json"} : {"Content-Type": "application/json"},
    signal: AbortSignal.timeout(backend.timeoutMs),
  };

  if (backend.method === "GET") {
    // LSTM workflow is configured as a GET webhook in n8n.
    const params = new URLSearchParams({
      room_id: String(roomId),
      timestamp: dateISO,
    });
    requestUrl = `${backend.url}?${params.toString()}`;
  } else {
    fetchOptions.body = JSON.stringify({ date: dateISO, room_id: roomId });
  }

  const r = await fetch(requestUrl, fetchOptions);
  if (!r.ok) throw new Error("HTTP " + r.status);
  const data = await r.json();

  // Normalize the old Ridge/AI response and the new LSTM response into the same UI shape.
  const normalized = {
    ...data,
    room_id: Number(data.room_id ?? roomId),
    date: data.date || data.timestamp || dateISO,
    temperature: Number(data.temperature ?? data.predicted_temperature ?? data.recommended_temperature),
    humidity: Number(data.humidity ?? data.predicted_humidity ?? data.recommended_humidity),
    temp_lower: data.temp_lower ?? data.temp_lower_limit,
    temp_upper: data.temp_upper ?? data.temp_upper_limit,
    hum_lower: data.hum_lower ?? data.humidity_lower_limit,
    hum_upper: data.hum_upper ?? data.humidity_upper_limit,
    temperature_status: data.temperature_status || data.temperature_anomaly || "Normal",
    humidity_status: data.humidity_status || data.humidity_anomaly || "Normal",
    recommendation: data.recommendation,
  };

  if (!Number.isFinite(normalized.temperature) || !Number.isFinite(normalized.humidity)) {
    throw new Error("bad response shape: " + JSON.stringify(data).slice(0, 120));
  }

  normalized._backendBadge = backend.badge;
  return normalized;
}

