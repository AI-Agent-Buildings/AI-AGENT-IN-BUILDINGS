  document.getElementById("hum-bar").style.background =
    `linear-gradient(90deg, var(--ink) 0%, var(--ink) ${hPct}%, var(--rule) ${hPct}%)`;
  document.getElementById("temp-sub").textContent =
    `Observed range ${fmt(stats.temp_min)}–${fmt(stats.temp_max)} °C · mean ${fmt(stats.temp_mean)} °C`;
  document.getElementById("hum-sub").textContent =
    `Observed range ${fmt(stats.hum_min)}–${fmt(stats.hum_max)} % · mean ${fmt(stats.hum_mean)} %`;

   document.getElementById("confidence").innerHTML =
  `<strong>${c.label}</strong>${c.note}`;

