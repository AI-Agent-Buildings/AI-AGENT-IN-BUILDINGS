async function runPrediction() {
  const btn = document.getElementById("predict-btn");
  const errBox = document.getElementById("error-box");
  errBox.classList.remove("visible");

  const dateStr = document.getElementById("date").value;
  const timeStr = document.getElementById("time").value || "12:00";
  const room    = +document.querySelector("input[name='room']:checked").value;
  if (!dateStr) { alert("Please pick a date."); return; }

  // Build a local Date to also drive the local fallback + confidence tier
  const [yy, mm, dd] = dateStr.split("-").map(Number);
  const [hh, mi]     = timeStr.split(":").map(Number);
  const target = new Date(yy, mm-1, dd, hh, mi);
  const dateISO = target.toISOString();

  const backend = currentBackend();
  btn.classList.add("loading");
  btn.disabled = true;
  const label = btn.querySelector(".btn-label");
  label.textContent =
    backend.url === null ? "Computing…" : `Asking ${backend.label}…`;

  let result, source;
  try {
    try {
      if (backend.url === null) {
        // Chose offline explicitly — skip network, go straight to local model.
        throw new Error("local-only");
      }
      result = await predictViaWebhook(dateISO, room);
      source = result._backendBadge || "webhook";  // regression | llm
    } catch (e) {
      // Any failure → fall back to local. Only show a note if the user was
      // actually expecting a remote backend to answer.
      const localPred = predictLocal(room, target);
      result = {
        temperature: localPred.temperature,
        humidity:    localPred.humidity,
        temp_mean: localPred.temp_mean,
        hum_mean: localPred.hum_mean,
        temp_lower: localPred.temp_lower,
        temp_upper: localPred.temp_upper,
        hum_lower: localPred.hum_lower,
        hum_upper: localPred.hum_upper,
        threshold_source: localPred.threshold_source,
        room_id: room,
        date: dateISO,
        model_data_range: BUNDLE.data_range,
      };
      source = "local";

      if (backend.url !== null && e.message !== "local-only") {
        errBox.innerHTML =
          `<strong>${backend.label} failed — using offline fallback.</strong>${e.message}.`;
        errBox.classList.add("visible");
      }
    }

    // Defensive: if the webhook responded but didn't include room_id, fill it in
    // from the current form state. Prevents a broken response from crashing render.
    if (result && (result.room_id == null || !Number.isFinite(+result.room_id))) {
      result.room_id = room;
    }

    try {
      renderResult(result, target, source);
    } catch (renderErr) {
      console.error("renderResult failed:", renderErr);
      errBox.innerHTML =
        `<strong>Rendering failed.</strong>${renderErr.message}. ` +
        `The webhook returned: <code>${JSON.stringify(result).slice(0, 200)}</code>`;
      errBox.classList.add("visible");
    }
  } finally {
    // Always reset the button, no matter what happened above.
    btn.classList.remove("loading");
    btn.disabled = false;
    label.textContent = "Predict";
  }
}

