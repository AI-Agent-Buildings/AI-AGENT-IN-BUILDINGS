  // Smart decimal count: if another room's reading for the same date is within
  // 0.5°C, show two decimals so the user can see the actual difference.
  const otherRooms = [1, 2, 3].filter(r => r !== p.room_id && lastByRoom[r] &&
                                           lastByRoom[r].date === target.toISOString());
  const tClose = otherRooms.some(r => Math.abs(lastByRoom[r].t - p.temperature) < 0.5);
  const hClose = otherRooms.some(r => Math.abs(lastByRoom[r].h - p.humidity)    < 1.5);
  const tDecimals = tClose ? 2 : 1;
  const hDecimals = hClose ? 2 : 1;

  const tEl = document.getElementById("temp-value");
