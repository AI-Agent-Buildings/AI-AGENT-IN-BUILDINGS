function subsample(arr, maxPts) {
  if (arr.length <= maxPts) return { arr, indices: arr.map((_,i) => i) };
  const step = Math.ceil(arr.length / maxPts);
  const out = [], idx = [];
  for (let i = 0; i < arr.length; i += step) { out.push(arr[i]); idx.push(i); }
  return { arr: out, indices: idx };
}

