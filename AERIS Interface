  const tPct = Math.max(0, Math.min(100, 100*(p.temperature - tMin)/(tMax - tMin)));
  const hPct = Math.max(0, Math.min(100, 100*(p.humidity    - hMin)/(hMax - hMin)));
  document.getElementById("temp-bar").style.background =
