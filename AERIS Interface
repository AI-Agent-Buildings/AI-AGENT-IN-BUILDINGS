function fmt(n, d=1) {
  if (n == null || !isFinite(n)) return "—";
  return Number(n).toLocaleString("en-GB", { minimumFractionDigits: d, maximumFractionDigits: d });
}

// Keep the last rendered values per room so we can tell when a room change
// produced a near-identical reading (rooms 1 and 3 have duplicate training data).
