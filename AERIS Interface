// ---- Fourier feature construction (matches the n8n Code node exactly) ----
function buildFeatures(date) {
  const hour = date.getUTCHours() + date.getUTCMinutes() / 60;
  const yearStart = Date.UTC(date.getUTCFullYear(), 0, 0);
  const doy = (date.getTime() - yearStart) / 86400000;
  const dow = ((date.getUTCDay() + 6) % 7) + hour / 24;
  const f = [];
  for (const k of [1,2,3]) {
    f.push(Math.sin(2*Math.PI*k*hour/24));
    f.push(Math.cos(2*Math.PI*k*hour/24));
  }
  for (const k of [1,2,3]) {
    f.push(Math.sin(2*Math.PI*k*doy/365.25));
    f.push(Math.cos(2*Math.PI*k*doy/365.25));
  }
  for (const k of [1,2]) {
    f.push(Math.sin(2*Math.PI*k*dow/7));
    f.push(Math.cos(2*Math.PI*k*dow/7));
  }
  return f;
}

const ROOM_NAMES = { 1: "Kitchen", 2: "Lab", 3: "Mailroom" };
function getRoomName(roomId) {
  return ROOM_NAMES[Number(roomId)] || `Room ${roomId}`;
}

function offlineMonthlyThresholds(roomId, date, temperature, humidity) {
  // Offline Backup cannot call n8n, so it estimates adaptive ranges locally.
  // The ranges change by month to reflect seasonal AC/humidity behavior.
  const month = date.getMonth() + 1;

  let tempBand;
  let humBand;

  // UAE/Sharjah indoor climate approximation:
  // winter is cooler/narrower, summer is warmer/wider, shoulder months are moderate.
  if ([12, 1, 2].includes(month)) {
    tempBand = 1.6;
    humBand = 8.0;
  } else if ([6, 7, 8, 9].includes(month)) {
    tempBand = 2.3;
    humBand = 12.0;
  } else {
    tempBand = 2.0;
    humBand = 10.0;
  }

  // Small room adjustment keeps rooms from having perfectly identical fallback ranges.
  const roomShift = Number(roomId) === 2 ? -0.2 : Number(roomId) === 3 ? 0.15 : 0;

  const tempMean = Number(temperature) + roomShift;
  const humMean = Number(humidity);

  return {
    temp_mean: Number(tempMean.toFixed(2)),
    hum_mean: Number(humMean.toFixed(2)),
    temp_lower: Number((tempMean - tempBand).toFixed(2)),
    temp_upper: Number((tempMean + tempBand).toFixed(2)),
    hum_lower: Number(Math.max(20, humMean - humBand).toFixed(2)),
    hum_upper: Number(Math.min(100, humMean + humBand).toFixed(2)),
    threshold_source: "offline-monthly-estimate"
  };
}

function predictLocal(roomId, date) {
  const f = buildFeatures(date);
  const m = BUNDLE.models[String(roomId)];
  const dot = (coef, intercept) =>
    intercept + coef.reduce((s, c, i) => s + c * f[i], 0);

  const temperature = dot(m.temperature.coef, m.temperature.intercept);
  const humidity = dot(m.humidity.coef, m.humidity.intercept);
  const thresholds = offlineMonthlyThresholds(roomId, date, temperature, humidity);

  return {
    temperature,
    humidity,
    ...thresholds,
  };
}

// ---- Confidence tier based on distance from training data ----
function confidenceFor(date) {
  const start = new Date(BUNDLE.data_range.start);
  const end   = new Date(BUNDLE.data_range.end);
  const MS = 30.44 * 86400000;
  if (date >= start && date <= end) {
    return { level: "high", label: "In-sample",
             note: "This date falls inside the training period. Expect MAE ≈ 0.4 °C and ≈ 6 %." };
  }
  const d = date < start ? (start - date) / MS : (date - end) / MS;
  if (d < 2)  return { level: "medium", label: "Near extrapolation",
                       note: `~${d.toFixed(1)} months outside training. Seasonal curve is well-anchored; treat as an educated estimate.` };
  if (d < 12) return { level: "low", label: "Far extrapolation",
                       note: `~${d.toFixed(1)} months outside training. The model has not observed this time of year — this is climatological, not a forecast.` };
  return { level: "caution", label: "Multi-year extrapolation",
           note: `${(d/12).toFixed(1)} years from training. Returned for completeness, but the model cannot know year-over-year trends.` };
}

